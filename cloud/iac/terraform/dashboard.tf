# Dashboard (Streamlit): a read-only IAM user and the complete secrets.toml, generated from this configuration.
#   tofu output -raw dashboard_secrets_toml > ../../streamlit/.streamlit/secrets.toml

resource "aws_iam_user" "dashboard" {
  count = var.create_dashboard_user ? 1 : 0
  name  = "${var.project_name}-${var.environment}-dashboard"
}

resource "aws_iam_user_policy" "dashboard" {
  count = var.create_dashboard_user ? 1 : 0
  name  = "read-readings"
  user  = aws_iam_user.dashboard[0].name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["dynamodb:Query"]
      Resource = module.dynamodb.table_arn
    }]
  })
}

resource "aws_iam_access_key" "dashboard" {
  count = var.create_dashboard_user ? 1 : 0
  user  = aws_iam_user.dashboard[0].name
}

locals {
  dashboard_nodes = [for id, n in var.nodes : {
    id         = id
    label      = coalesce(n.label, id)
    city       = n.city
    ml_station = "v1 Brazil — INMET × INPE"
    lat        = n.lat
    lon        = n.lon
  }]

  dashboard_nodes_toml = join("\n", [for n in local.dashboard_nodes : join("\n", concat(
    ["[[nodes]]"],
    [for k in ["id", "label", "city", "ml_station", "lat", "lon"] : format("%-10s = %s", k, jsonencode(n[k]))],
    [""]
  ))])
}

output "dashboard_secrets_toml" {
  description = "Complete secrets.toml for the dashboard (AWS credentials, region, table and nodes)"
  sensitive   = true
  value = join("\n", [
    "# Generated by `tofu output -raw dashboard_secrets_toml`. Do not edit: change terraform.tfvars and regenerate.",
    format("AWS_ACCESS_KEY_ID = %s", jsonencode(var.create_dashboard_user ? aws_iam_access_key.dashboard[0].id : "REPLACE_WITH_YOUR_ACCESS_KEY_ID")),
    format("AWS_SECRET_ACCESS_KEY = %s", jsonencode(var.create_dashboard_user ? aws_iam_access_key.dashboard[0].secret : "REPLACE_WITH_YOUR_SECRET_ACCESS_KEY")),
    format("AWS_REGION = %s", jsonencode(var.aws_region)),
    format("DYNAMODB_TABLE = %s", jsonencode(module.dynamodb.table_name)),
    "",
    local.dashboard_nodes_toml,
  ])
}

output "dashboard_nodes_json" {
  description = "Node list as JSON, for the dashboard's NODES_JSON environment variable on hosts other than Streamlit Cloud"
  value       = jsonencode(local.dashboard_nodes)
}
