# Gateway: the AWS IoT part of its firmware configuration, generated from this configuration.
#   tofu output -raw gateway_aws_config > ../../../firmware/gateway_aws.h
# Only Wi-Fi is typed by hand (firmware/site_config.h).

output "gateway_aws_config" {
  description = "firmware/gateway_aws.h: AWS IoT endpoint, client ID, Amazon Root CA 1 and the gateway's certificate and private key"
  sensitive   = true
  value = join("\n", [
    "// Generated by `tofu output -raw gateway_aws_config`. Do not edit: regenerate it after `tofu apply`.",
    "// Holds the gateway's private key: never commit it (it is gitignored).",
    "#pragma once",
    "",
    format("#define AWS_IOT_ENDPOINT  %s", jsonencode(module.iot_core.iot_endpoint)),
    "#define AWS_IOT_PORT      8883",
    "// Must start with \"forest-fire-\" (allowed by the IoT policy).",
    "#define AWS_IOT_CLIENT_ID \"forest-fire-gateway\"",
    "",
    "static const char AWS_CERT_CA[] PROGMEM = R\"EOF(",
    trimspace(file("${path.module}/certs/AmazonRootCA1.pem")),
    ")EOF\";",
    "",
    "static const char AWS_CERT_CRT[] PROGMEM = R\"EOF(",
    trimspace(module.iot_core.certificate_pems["gateway"]),
    ")EOF\";",
    "",
    "static const char AWS_CERT_PRIVATE[] PROGMEM = R\"EOF(",
    trimspace(module.iot_core.private_keys["gateway"]),
    ")EOF\";",
    "",
  ])
}
