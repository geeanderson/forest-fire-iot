# Reference only. The real secrets.toml is generated by Terraform from terraform.tfvars:
#   cd cloud/iac/terraform && tofu output -raw dashboard_secrets_toml > ../../streamlit/.streamlit/secrets.toml
# On Streamlit Cloud, paste the same content under Settings > Secrets. Never commit secrets.toml.

AWS_ACCESS_KEY_ID = "AKIA..."          # read-only IAM user created by Terraform (dynamodb:Query)
AWS_SECRET_ACCESS_KEY = "..."
AWS_REGION = "us-east-1"
DYNAMODB_TABLE = "forest-fire-readings"

# One [[nodes]] table per node (keep them after the keys above). Optional fields: label, city, ml_station.
# On other hosts, the same list can be given as JSON in the NODES_JSON environment variable
# (tofu output -raw dashboard_nodes_json).
[[nodes]]
id         = "node-01"
label      = "Node 01"
city       = "Cornélio Procópio, PR"
ml_station = "v1 Brazil — INMET × INPE"
lat        = -23.181
lon        = -50.647
